# Current development baseline: local Ollama + Gemma 4 26B
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:26b
OLLAMA_BASE_URL=http://localhost:11434

# Keep 0 for the LLM-backed demo; use 1 only for deterministic/offline tests.
INBOXHERO_OFFLINE=0

# Optional compatibility provider. Leave blank when using Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
